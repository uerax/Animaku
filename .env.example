# API server (Hono)
# - Local `pnpm dev` / production single process / Docker host port binding
# - 0.0.0.0（默认）：监听所有网卡，允许公网/局域网直接访问
# - 127.0.0.1：仅限本机或本机反向代理（Nginx / Caddy）访问，禁止公网直连
HOST=0.0.0.0
PORT=8787

# ── 数据持久化与数据库配置 ──────────────────────────────────────────
# 是否启用数据库持久化（默认: false，无状态轻量/纯内存模式，0 数据库文件与磁盘 I/O）
# - 个人自用/NAS：保持默认 false 即可，个人追番/历史全在浏览器本地，完全无需维护数据库
# - 公网建站部署：设为 true，开启全站播放量统计、访客 PV 统计与长效搜索缓存
# DB_ENABLED=false
# DB_DRIVER=sqlite
# DATA_DIR=./data
# SQLITE_PATH=./data/animaku.db

# Website — Vite local dev only (pnpm dev / pnpm dev:web)
# Production Docker / `pnpm start` serve SPA on PORT (WEB_DEV_PORT unused)
# WEB_HOST default in code is 127.0.0.1 if unset
WEB_HOST=0.0.0.0
WEB_DEV_PORT=5173

# CORS_ORIGINS=https://app.example.com   # extra browser Origins (localhost always ok)
# CORS_ORIGINS=*          # open CORS (not recommended)

# DanDanPlay credentials (optional)
# Leave empty to use the same built-in client keys as agefans-enhance (local/dev).
# For production, apply open-platform keys at https://www.dandanplay.com/
DANDAN_APP_ID=
DANDAN_APP_SECRET=

# Optional UA overrides (defaults are fine for most local installs)
# Bangumi: non-browser clients should use developer/App/version + open-source homepage
# BANGUMI_USER_AGENT=uerax/Animaku/1.1.1 (https://github.com/uerax/Animaku)
# PRODUCT_USER_AGENT=Animaku/1.1.1
# APP_VERSION=v1.1.1
DEFAULT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36

# Optional rule shop URLs
# PLUGIN_SHOP=https://raw.githubusercontent.com/Predidit/KazumiRules/main/
# PLUGIN_SHOP_MIRROR=https://raw.gitcode.com/gh_mirrors/ka/KazumiRules/raw/main/

# ── 站点公网域名 (SEO / 搜索引擎收录) 与 IndexNow 协议 ───────────────────
# 【新手选填指南】：
# 1. 个人自用 / NAS / 局域网看番：全部留空即可，无需任何配置！
# 2. 公网建站（绑定了域名）：通常只需要填写下面的 SITE_URL（末尾不要带斜杠 /）。
#
# 常见疑惑：为什么有两个域名选项？有什么区别？
# ● SITE_URL（服务端动态生效，推荐配置此项）：
#   - 生效方式：修改后直接【重启服务】即刻生效。
#   - 实际用途：用于服务端自动生成 sitemap.xml 网站地图、robots.txt 爬虫规则，以及向搜索引擎推送收录地址。
#   - 填写示例：SITE_URL=https://anime.example.com
#
# ● VITE_SITE_URL（前端打包时生效，绝大多数用户请直接留空）：
#   - 生效方式：属于前端构建期变量，修改后必须【重新打包构建】(如 docker compose build) 才会编译进网页。
#   - 实际用途：仅用于纯前端静态托管时硬编码首屏社交分享卡片（OpenGraph）。
#   - 友好兜底：若留空，前端会自动以浏览器当前访问的实际域名为准，完全不影响正常使用。
#
# SITE_URL=https://anime.example.com
# VITE_SITE_URL=https://anime.example.com

# ── IndexNow 搜索引擎即时推送协议 ──────────────────────────────────────
# IndexNow 协议（支持 Bing 必应、Yandex、Naver 等主流搜索引擎即时快速收录）：
# - 个人自用：保持默认关闭（0）即可，无需开启。
# - 公网建站：配置好上面的 SITE_URL 后，设为 1 开启。开启后服务端在启动及定时刷新时会自动将最新番剧链接推送给搜索引擎。
# INDEXNOW_ENABLED=1
#
# IndexNow 站点所有权验证密钥（服务端已内置验证路由 /{INDEXNOW_KEY}.txt，保持默认即可）：
# INDEXNOW_KEY=4ddfeb9c68384dd99bc302fb0f02eaf1

# 管理员鉴权密码（用于调用 POST /api/admin/indexnow 触发全量推送等受保护的管理接口，建议公网建站时设置）：
# ADMIN_SECRET=your_admin_secret_here

# ── 站点访客分析与统计 (Analytics; Vite 构建期注入) ──────────────
# 默认留空不注入任何统计代码，避免本地开发产生脏数据。
# 适用于生产部署（仅在构建时注入 HTML；修改配置后需重新构建镜像）。
# 使用 docker compose build 时会自动读取 .env 传入构建参数；原生 docker build 需显式携带 --build-arg。
# 各分析平台（Clarity、GA4 等）原生支持 SPA 单页应用并自动捕获路由切换。启用后请遵守所在地合规要求并履行告知义务。
# Microsoft Clarity（热力图、点击流与屏幕录屏）：填入项目 ID（通常为10位字符）
# VITE_CLARITY_ID=your_clarity_project_id
# Google Analytics 4 (GA4) 衡量 ID（格式为 G-XXXXXXXXXX）：
# VITE_GA_ID=G-XXXXXXXXXX
# 百度统计站点 ID（可选）：
# VITE_BAIDU_TONGJI_ID=

# ── Bangumi 接口与封面图片源配置 ───────────────────────────────
# 可选模式：mirror（代理免翻，默认） / official（官方直连）
# 同时也支持直接输入自定义域名（如 api.bgm.tv / bgmapi.anibt.net）
#
# 常见配置示例：
# 1. 默认（全部走免翻代理，留空即可）：
#    BANGUMI_API=mirror
#    BANGUMI_IMAGE=mirror
#
# 2. API 走官方直连，图片走代理：
#    BANGUMI_API=official
#    BANGUMI_IMAGE=mirror
#
# 3. 全部走官方直连（国内不稳定）：
#    BANGUMI_API=official
#    BANGUMI_IMAGE=official
BANGUMI_API=mirror
BANGUMI_IMAGE=mirror

# ── Web footer branding (Vite build-time; prefix VITE_ required) ─────────────
# Shown on non-watch pages. Leave blank to hide maintainer / extra links.
# Docker: baked at image build — change then `docker compose up -d --build`.
# Version defaults to package.json version when unset.
# VITE_APP_VERSION=v1.1.1
# GitHub defaults to https://github.com/uerax/Animaku when unset.
# VITE_GITHUB_URL=https://github.com/uerax/Animaku
# VITE_GITHUB_LABEL=GitHub
# VITE_PRODUCT_NAME=Animaku
# VITE_SITE_TAGLINE=在线弹幕播放
# VITE_MAINTAINER_NAME=
# VITE_MAINTAINER_URL=https://github.com/yourname
# VITE_HOMEPAGE_URL=
# VITE_HOMEPAGE_LABEL=主页
# VITE_CONTACT_EMAIL=
# VITE_FOOTER_NOTE=

# ── 导航栏与界面外观出厂默认配置 (Nav & Appearance Defaults) ────────
# 用于自托管 / 私有部署站点定制新访客的初始展示状态（单端用户仍可在设置页个性化覆盖并保存在本地）。
# Docker 部署：属于 Vite 构建期烘焙变量，修改后需执行 docker compose up -d --build 重新构建镜像生效。
#
# 默认主题：light（浅色，默认） / dark（深色）
# VITE_DEFAULT_THEME=light
#
# 顶部导航栏右侧快捷功能出厂默认展示状态（1 为开启展示，0 为默认隐藏）
# VITE_NAV_SHOW_USER_MENU=1     # 用户中心下拉入口（我的追番、历史、设置等）
# VITE_NAV_SHOW_HISTORY=1       # 观看历史时钟图标
# VITE_NAV_SHOW_THEME_TOGGLE=1  # 黑白模式一键切换按钮
# VITE_NAV_SHOW_GITHUB=1        # GitHub 仓库链接

# ── 服务端时区配置 (Timezone) ──────────────────────────────────
# 控制服务端日志输出时间及时间戳格式化时区，默认使用 Asia/Shanghai（中国标准时间 UTC+8）。
# 支持标准的 IANA 时区名称（如 Asia/Shanghai, Asia/Tokyo, America/New_York, UTC 等）。
# TZ=Asia/Shanghai

# ── Docker 日志控制器与持久化配置 ──────────────────────────────
# 控制 Docker 容器日志单文件大小上限、保留历史轮转文件数量与归档压缩
# LOG_MAX_SIZE=5m
# LOG_MAX_FILE=10

# ── 服务端访问日志输出格式 ─────────────────────────────────────
# 可选值：
# - pretty（默认）：带色彩的高可读性单行日志，展示极简客户端系统标识（如 [Win11]、[iPhone]、[Android]）与业务参数；
# - json：标准单行 JSONL 结构化日志，包含设备详情（操作系统、浏览器、设备类别），适合接入 Loki / ELK 或自动化分析。
# LOG_FORMAT=pretty

# ── 视频源出站正向代理池 (Outbound Proxies for Video Sources) ──
# 仅当服务端部署在特定限制地区（如日本 VPS 被 cycani 封锁 IP，或大陆 VPS 访问港台源受限）时按需配置。
# 仅用于拉取源站 API 元数据（搜索、选集、直链），零媒体视频流消耗！
# 协议支持：http://, https://, socks5:// (支持 socks5://user:password@host:port)
#
# 1. 定义出站代理节点（变量名格式为 PROXY_<标识>）：
# PROXY_1=http://127.0.0.1:7890
# PROXY_2=socks5://127.0.0.1:1080
# PROXY_CN=http://192.168.1.100:7890
#
# 2. 视频源到代理的映射表（格式：视频源名称:代理变量名，多个用逗号分隔，不区分大小写）：
# 映射名称直接与上面定义的变量名严格对应（如 PROXY_1、PROXY_2 或 PROXY_CN）：
# 未在映射表中的视频源默认直接连接源站（Direct 直连）
# SOURCE_PROXY_MAP=cycani:PROXY_1,anime1:PROXY_2
#
# 也支持单独针对某个源设置环境变量覆盖：
# SOURCE_PROXY_CYCANI=PROXY_1



